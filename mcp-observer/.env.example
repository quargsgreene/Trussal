# Copy to .env and fill in your values.
# .env is gitignored — never commit credentials.

# WebSocket URL for the latency sidecar on the video VM.
# The observer connects here as a passive peer to buffer live room state.
VIDEO_WS_URL=ws://video-vm:8081

# HTTP URL for the conductor admin API on the bots VM.
BOTS_ADMIN_URL=http://bots-vm:7777

# SSH connection strings for VM health checks (optional).
# Must be key-based auth; the observer calls ssh directly.
VIDEO_VM_SSH=user@192.168.1.254
AUDIO_VM_SSH=user@192.168.1.120
BOTS_VM_SSH=user@192.168.1.232

# Comma-separated room names to observe persistently.
# The observer maintains one WebSocket connection per room.
OBSERVE_ROOMS=0
