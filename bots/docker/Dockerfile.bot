# One container per bot (spec): headless Chromium + Xvfb + ALSA loopback
# client side + the Node bot driver.
#
# Debian base rather than Alpine: Chromium, ALSA are all packaged
# and battle-tested on glibc; Alpine's musl builds of Chromium lag and break
# WebGL (which Hydra needs).
#
# BUILD CONTEXT IS THE REPO ROOT (see docker-compose.yml + the root
# .dockerignore): the bot imports shared modules that live outside bots/
# (src/audio-net, latency-instrument, public/lib), so the image mirrors the
# repo layout under /repo and the source's ../../../ imports resolve exactly
# as they do in a dev checkout.

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    xvfb \
    alsa-utils \
    jackd2 \
    ca-certificates \
    fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /repo/bots

COPY bots/package.json ./
RUN npm install --omit=dev

COPY bots/src ./src
# The output stage's vendored libraries (p5.js + three.js), read by the
# aggregator only when a program actually asks for a shape — so the COPY
# lands them at bots/vendor/, the path ../../vendor/ resolves to from the
# bot source, and a no-shape program still never pays the read.
COPY bots/vendor ./vendor
# Shared repo-root trees, kept at their repo-relative paths so the same
# import specifiers work in dev and in the image. The node_modules symlink
# lets bare specifiers used by the shared modules (yjs) resolve by walking
# up from /repo/src — the dev checkout's root node_modules plays that role
# locally.
COPY src/audio-net /repo/src/audio-net
# The mosaic's membership rule (MosaicCells.js imports it) — the one place
# that decides what counts as Hydra code, shared with the browser so a cell
# can never appear for code the browser doesn't treat as Hydra. A src/-root
# file rather than an audio-net one, so the tree COPY above doesn't cover it.
COPY src/hydra-code.js /repo/src/hydra-code.js
# hydra-code.js imports it: the `botConfig(...)` rule, stripped by the same
# normalizer that finds a Hydra preamble. Another src/-root file, so it needs
# its own COPY and its own .dockerignore whitelist entry.
COPY src/bot-config.js /repo/src/bot-config.js
# hydra-code.js also imports it: the 'personal editor' / 'metaprogram editor' /
# 'bot editor' directive rule, stripped by the same normalizer. Another
# src/-root file, same two entries.
COPY src/program-directive.js /repo/src/program-directive.js
# hydra-code.js and MetaprogrammerParser.js both import it: the one rule for a
# buffer's mini-vs-mondo surface notation and the transforms between them, so a
# bot lowers a mondo editor buffer exactly as the browser does. Sixth src/-root
# file, same two entries.
COPY src/notation.js /repo/src/notation.js
# The Text Cycles declaration rule (bot.js imports it): the bot hands both
# capability rules to its page scripts, which are serialised function bodies and
# cannot import anything themselves. A third src/-root file, same two entries.
COPY src/text-cycles-core.js /repo/src/text-cycles-core.js
# The label-aware voice/fx wrapper (cluster-source.js and variation.js import
# it), shared with the browser so a bot's per-bot mix chain wraps a performer's
# code the same safe way strudel.js does. A fourth src/-root file, same two
# entries.
COPY src/strudel-voice.js /repo/src/strudel-voice.js
# dropCssStatements' CSS_CALL_RE (cluster-source.js imports it) — the css()
# sibling of WORD_CALL_RE above. A fifth src/-root file, same two entries.
COPY src/css-cycles-core.js /repo/src/css-cycles-core.js
# dropLiveCaptureStatements' LIVECAPTURE_CALL_RE (cluster-source.js imports
# it) — the liveCapture() sibling of WORD_CALL_RE/CSS_CALL_RE above. Same two
# entries.
COPY src/live-capture-core.js /repo/src/live-capture-core.js
# hydra-code.js also imports it: FILE_CALL_RE, the image()/video()/textFile()/
# pdfFile()/soundFile() call shape. Same two entries.
COPY src/file-cycles-core.js /repo/src/file-cycles-core.js
# hydra-code.js also imports it: POLL_CALL_RE, the poll() call shape. Same two
# entries.
COPY src/polls-core.js /repo/src/polls-core.js
# `# inhabit`'s rules (src/inhabit-core.js): MetaprogrammerParser.js imports
# it to read the directive, and the aggregator to resolve the map each cycle
# and fold guests' audio into their hosts' slots. It imports breakout-core.js
# for the room planner, which in turn imports text-cycles-core.js (above).
# Same two entries each.
COPY src/inhabit-core.js /repo/src/inhabit-core.js
# permissionsConfig(...) (src/permissions-config.js): hydra-code.js strips the
# declaration with it, and bot.js hands its statement shape to the page
# scripts. Imports bot-config.js and inhabit-core.js, both copied. Same two
# entries.
COPY src/permissions-config.js /repo/src/permissions-config.js
COPY src/breakout-core.js /repo/src/breakout-core.js
# HMR stable-state (for persistent Yjs/WS state across hot reloads).
# Required by MetaprogrammerCrdtSync.js in the bot image.
COPY src/stable-state.js /repo/src/stable-state.js
# Backing voices (src/backing-core.js): cluster-source.js reads BACKING_CALL_RE,
# aggregator-bot.js resolves each peer's backings. Imports only files copied
# above. Same two entries.
COPY src/backing-core.js /repo/src/backing-core.js
# hydra-code.js also imports it: the output-route directive rule. Same two
# entries.
COPY src/output-route-core.js /repo/src/output-route-core.js
# hydra-code.js also imports it: MULTI_CALL_RE, so a performer drawing Hydra
# through multiArrange()/multiStack() is blitted rather than re-executed.
# Imports only file-cycles-core.js, copied above. Same two entries.
COPY src/multimedia-core.js /repo/src/multimedia-core.js
COPY latency-instrument /repo/latency-instrument
COPY public/lib /repo/public/lib
RUN ln -s bots/node_modules /repo/node_modules

COPY bots/docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Import guard: fail the BUILD if any module in the bot's import graph cannot
# load inside the image (e.g. an import of a repo file that was never copied
# in). A runtime import failure would otherwise deploy bots that spawn and
# instantly crash without ever joining.
COPY bots/docker/verify-imports.mjs ./docker/verify-imports.mjs
RUN node docker/verify-imports.mjs

# Launch guard: Debian's Chromium is rolling, so a bump can outpace the pinned
# puppeteer-core and make Chromium abort at startup — bots would then deploy and
# silently crash without joining. Fail the BUILD instead. Runs under Xvfb
# (launch is headless:false) with the exact runtime launch config.
COPY bots/docker/verify-launch.mjs ./docker/verify-launch.mjs
RUN Xvfb :99 -screen 0 1280x720x24 -nolisten tcp & \
    for i in $(seq 1 20); do xdpyinfo -display :99 >/dev/null 2>&1 && break; sleep 0.25; done; \
    DISPLAY=:99 node docker/verify-launch.mjs; status=$?; \
    rm -rf /tmp/verify-profile /tmp/.X99-lock 2>/dev/null || true; \
    exit $status

# DISPLAY is set per-bot in the entrypoint (host networking shares the
# abstract socket namespace, so display numbers must be unique).
# JACK_NO_AUDIO_RESERVATION: jackd2 otherwise insists on D-Bus device
# reservation, which doesn't exist in a container ("Audio device cannot
# be acquired").
ENV CHROMIUM_PATH=/usr/bin/chromium \
    JACK_NO_AUDIO_RESERVATION=1

ENTRYPOINT ["/entrypoint.sh"]
