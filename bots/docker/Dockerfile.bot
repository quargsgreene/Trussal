# One container per bot (spec): headless Chromium + Xvfb + ALSA loopback
# client side + ffmpeg + Jamulus client + the Node bot driver.
#
# Debian base rather than Alpine: Chromium, ALSA and Jamulus are all packaged
# and battle-tested on glibc; Alpine's musl builds of Chromium lag and break
# WebGL (which Hydra needs).

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    xvfb \
    ffmpeg \
    alsa-utils \
    jackd2 \
    jamulus \
    ca-certificates \
    fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY src ./src
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# DISPLAY is set per-bot in the entrypoint (host networking shares the
# abstract socket namespace, so display numbers must be unique).
# JACK_NO_AUDIO_RESERVATION: jackd2 otherwise insists on D-Bus device
# reservation, which doesn't exist in a container ("Audio device cannot
# be acquired").
ENV CHROMIUM_PATH=/usr/bin/chromium \
    JACK_NO_AUDIO_RESERVATION=1

ENTRYPOINT ["/entrypoint.sh"]
