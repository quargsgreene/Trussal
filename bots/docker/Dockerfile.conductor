# Conductor + admin API container. Needs the docker CLI (not the daemon) to
# start/stop bot containers through the mounted /var/run/docker.sock.

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
RUN npm install --omit=dev

COPY src ./src

EXPOSE 7700 7777

CMD ["node", "/app/src/orchestrator/index.js"]
