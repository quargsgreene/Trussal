# Compose-level overrides — copy to .env and fill in your values.
# HTTPS is required: browsers expose WebRTC (navigator.mediaDevices) only in
# secure contexts, so a plain-HTTP URL makes Jitsi report "WebRTC not
# supported". The cert is self-signed; bot Chromium runs with
# --ignore-certificate-errors, and human viewers accept the warning once.
# Only the host matters — the fleet rewrites the room segment per meeting, so
# the trailing "/0" is a template, not the room bots are pinned to.
JITSI_URL=https://<your-jitsi-host>/0

# Address of the self-hosted Jamulus server. Using a LAN IP (rather than the
# DuckDNS name) keeps 10 bots' audio off the router's WAN uplink and avoids
# hairpin NAT.
JAMULUS_SERVER=<host>:22000

# --- Fleet service (the aggregator + the Spawn button) ---
# The conductor must join the peer-state sidecar bus to discover rooms and to
# receive in-room spawn requests. The sidecar runs on the VIDEO VM behind nginx
# at wss://<jitsi-host>/ws — set that here (the localhost default is wrong on
# this VM, so with it unset the fleet sees no rooms at all: no aggregator
# appears and the Spawn button does nothing).
#
# This is a Node WebSocket client doing STRICT TLS verification (no
# --ignore-certificate-errors), so the host here must be one the sidecar's
# origin cert actually covers. If browsers reach the app under a name that only
# a CDN/edge cert covers (e.g. an apex that redirects to it), do NOT use that
# name here — use the name on the origin's own Let's Encrypt cert. With
# SIDECAR_HOST_ALIAS set (below) the fleet talks straight to the origin on the
# LAN, bypassing the edge entirely, so the origin cert is the only one in play.
SIDECAR_WS_URL=wss://<origin-cert-hostname>/ws

# Shared secret for the relay's control channel, which lists every meeting in
# progress. /ws is proxied to the public internet with no auth of its own and
# room names are the only gate on joining, so the relay refuses that channel
# unauthenticated. Must equal SIDECAR_CONTROL_TOKEN on the video VM (set it in
# docker-jitsi-meet/.env). Generate one with: openssl rand -hex 32
FLEET_CONTROL_TOKEN=<same-value-as-SIDECAR_CONTROL_TOKEN-on-the-video-vm>

# Multi-shard deploy only (edge/README.md): a comma-separated list of EACH
# shard's own sidecar URL, for the `?role=control` room-discovery connections.
# `?role=control` carries no room, so the edge LB can't route it — it has to
# reach every shard's sidecar directly. Leave unset for a single stack (the one
# SIDECAR_WS_URL is used). SIDECAR_HOST_ALIAS still applies to each. Every
# shard's SIDECAR_CONTROL_TOKEN must equal FLEET_CONTROL_TOKEN.
#SIDECAR_CONTROL_URLS=wss://<s1-origin-name>/ws,wss://<s2-origin-name>/ws

# There is deliberately no room setting. The fleet serves every room it
# discovers over the control channel and rewrites JITSI_URL's room segment per
# meeting, so there is nothing here to point at the room your humans join.
# In a multi-shard deploy SIDECAR_WS_URL is the EDGE LB (it routes the per-room
# ?role=fleet connections by ?room=); SIDECAR_CONTROL_URLS are the shards.

# The conductor runs in a bridge-networked container. If your LAN can't hairpin
# the public Jitsi hostname (common) and/or the sidecar's cert is for that
# public name rather than the LAN IP, alias the hostname to the video VM's LAN
# IP so the fleet reaches the sidecar over the LAN with a valid cert. The
# hostname here MUST be the one used in SIDECAR_WS_URL (the origin-cert name),
# so the TLS name check still passes against the origin cert.
SIDECAR_HOST_ALIAS=<origin-cert-hostname>:<video-vm-lan-ip>
