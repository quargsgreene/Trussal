# edge/.env — the edge host (AMD) of a sharded rack. gitignored; never commit.
# Not used in a single-box deploy (run.sh handles coturn + ddns there).

# --- coturn (the one TURN relay for the whole rack) ---
# Must equal every shard's docker-jitsi-meet/.env TURN_CREDENTIALS
# (= prosody's external_service_secret). Generate: openssl rand -hex 32
TURN_CREDENTIALS=
# The public name clients reach TURN on — the apex, which resolves here.
TURN_HOST=trussal.com
# Current public IP. Left blank is fine on first boot: `make deploy-edge` runs
# scripts/refresh-turn-external-ip.sh (TURN_ENV_FILE=edge/.env) which fills and
# then keeps it current via cron.
TURN_EXTERNAL_IP=
TURN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
# TURNS_PORT=5349   # only if you add a cert + turns: listener, see edge/README.md

# --- ddns (the one Cloudflare DNS updater) ---
# A scoped token with Zone:DNS:Edit on the trussal.com zone.
CF_API_TOKEN=
DDNS_DOMAINS=trussal.com,meet.trussal.com
