# bots: extracted Chrome binary (~250 MB, re-install with `npm run install-chrome`)
bots/chrome/
# --- OS cruft ---
.DS_Store
Thumbs.db
Icon?
ehthumbs.db
# Jitsi runtime config (local-only, generated by docker-jitsi-meet). Anchored
# to the repo root (leading slash) — a bare `config/` also matched
# loadtest/config/ at any depth, silently dropping the harness's committed
# scenarios.yaml/netem_profiles.yaml/inventory.example.yaml from every push
# since the harness landed (3ee8507) until this fix.
.jitsi-meet-cfg/
/config/
/cfg/

# Jamulus logs / runtime
jamulus/logs/
jamulus/*.log

# --- Editors / IDEs ---
.vscode/
.idea/
*.code-workspace
.history/
.fleet/

# --- Monorepo task runners / caches ---
.turbo/
.nx/cache/
.pnpm-store/

# --- Node / TypeScript ---
node_modules/
dist/
build/
# Un-ignore vendored strudel-fork built outputs so Trussal builds work after clone
!strudel-fork/**/dist/
!strudel-fork/**/dist/**
lib/
# ...but public/lib/o2lite-web.js is hand-written source (Trussal's O2lite WS
# client), not a build artifact. Keep it tracked despite the generic lib/ rule
# above — a parent dir must be re-included before a file inside it can be.
!public/lib/
!public/lib/o2lite-web.js
out/
.next/
.nuxt/
.cache/
.eslintcache
.npm/
.pnp.*
*.tsbuildinfo
coverage/
.nyc_output/
storybook-static/
