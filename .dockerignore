# Build context for bots/docker/Dockerfile.bot, whose context is the repo
# root (see bots/docker-compose.yml) because the bot image copies shared
# trees from outside bots/. Whitelist only what that Dockerfile COPYs so the
# context stays small (.git, dist, strudel-fork, docker-jitsi-meet etc. are
# all excluded by the leading *).
*
!bots
!src/audio-net
!src/hydra-code.js
!src/program-directive.js
!src/bot-config.js
!src/text-cycles-core.js
!src/css-cycles-core.js
!src/strudel-voice.js
!latency-instrument
!public/lib
bots/node_modules
bots/chrome
bots/test
latency-instrument/node_modules
