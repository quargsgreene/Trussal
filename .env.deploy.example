# Copy to .env.deploy and fill in your values.
# .env.deploy is gitignored — never commit credentials.

# SSH connection strings for each VM. Format: user@hostname-or-ip
VIDEO_VM=user@<video-vm-ip>
AUDIO_VM=user@<audio-vm-ip>
BOTS_VM=user@<bots-vm-ip>

# --- Multi-shard rack (optional; edge/README.md, docker-jitsi-meet/MULTISHARD.md)
# SHARD_VMS: space-separated user@host list, one FULL Jitsi stack per host,
# each behind the consistent-hash edge on EDGE_VM. Leave both unset for the
# single-stack deploy (SHARD_VMS then defaults to VIDEO_VM and there is no edge).
#SHARD_VMS=user@<dell-a-ip> user@<dell-b-ip>
#EDGE_VM=user@<amd-ip>

# Absolute path to the cloned repo on each VM.
# REPO_PATH is the shared default; per-VM overrides take precedence when set.
REPO_PATH=/home/trussal/Trussal
#VIDEO_REPO_PATH=/home/video/Trussal
#AUDIO_REPO_PATH=/home/audio/Trussal
#BOTS_REPO_PATH=/home/bots/Trussal
#SHARD_REPO_PATH=/home/trussal/Trussal
#EDGE_REPO_PATH=/home/trussal/Trussal

# collect-session-logs: where each shard's `latency` sidecar writes SESSION_LOG_DIR
# JSONL (inside its repo), and where `make collect-session-logs` rsyncs them.
#SESSION_LOG_REMOTE=/home/trussal/Trussal/docker-jitsi-meet/session-logs
#SESSION_LOG_LOCAL=loadtest/results/_session-logs
