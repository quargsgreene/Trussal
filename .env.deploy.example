# Copy to .env.deploy and fill in your values.
# .env.deploy is gitignored — never commit credentials.

# SSH connection strings for each VM. Format: user@hostname-or-ip
VIDEO_VM=user@<video-vm-ip>
AUDIO_VM=user@<audio-vm-ip>
BOTS_VM=user@<bots-vm-ip>

# Absolute path to the cloned repo on each VM.
# REPO_PATH is the shared default; per-VM overrides take precedence when set.
REPO_PATH=/home/trussal/Trussal
#VIDEO_REPO_PATH=/home/video/Trussal
#AUDIO_REPO_PATH=/home/audio/Trussal
#BOTS_REPO_PATH=/home/bots/Trussal
